# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string used by Prisma (prisma7.config.ts).
# Local option: `npx prisma dev` spins up a local Postgres instance for you
# and prints a connection string to use here.
# Hosted option: Prisma Postgres (`npx create-db` or console.prisma.io) —
# the convention used across other projects on this Prisma generation.
#
# `npx create-db` prints the connection string inside a decorative box
# (lines prefixed with "|"). Copy ONLY the string itself — from "postgres://"
# to the end of the line — onto ONE line here, in quotes. Pasting the whole
# boxed block (or letting it wrap across lines) is the #1 cause of a
# "P1013: scheme is not recognized" error from `prisma migrate`.
#
# `create-db` databases are temporary — it also prints a "Claim Your
# Database" URL. Open that and claim it, or it's deleted within ~24h.
DATABASE_URL="postgresql://user:password@localhost:5432/zambitour?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth. Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Bootstrap admin — creates the first Administrator account, then you can
# remove these three lines. Run: npm run admin:bootstrap
BOOTSTRAP_ADMIN_NAME="ZambiTour Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@zambitour.co.mz"
BOOTSTRAP_ADMIN_PASSWORD="zambitour123"
